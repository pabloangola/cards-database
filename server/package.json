{
	"name": "@tcgdex/server",
	"private": true,
	"main": "dist/index.js",
	"scripts": {
		"compile": "node run-bun.mjs compiler/index.ts",
		"compile:force": "node run-bun.mjs compiler/index.ts --force",
		"prestart": "node ensure-generated.mjs",
		"dev": "node run-bun.mjs --watch src/index.ts",
		"daemon": "node dev-daemon.mjs",
		"validate": "tsgo --noEmit --project ./tsconfig.json",
		"start": "node run-bun.mjs src/index.ts"
	},
	"license": "MIT",
	"dependencies": {
		"@cachex/memory": "^1.0.1",
		"@dzeio/config": "^1.1.12",
		"@dzeio/object-util": "^1.9.1",
		"@dzeio/queue": "^1.2.1",
		"@sentry/node": "^8.55.0",
		"@tcgdex/sdk": "^2.6.0",
		"apicache": "^1.6.3",
		"express": "^4.21.2",
		"graphql": "^15.10.1",
		"graphql-http": "^1.22.4",
		"ruru": "^2.0.0-beta.22",
		"swagger-ui-express": "^5.0.1",
		"yaml": "^2.7.1"
	},
	"devDependencies": {
		"@types/apicache": "^1.6.7",
		"@types/express": "^4.17.21",
		"@types/node": "^20.17.32",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript/native-preview": "^7.0.0-dev.20250805.1",
		"glob": "^10.4.5",
		"typescript": "^4.9.5"
	}
}
