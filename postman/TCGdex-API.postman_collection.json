		{
			"name": "GraphQL",
			"item": [
				{
					"name": "Query - List cards",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"query { cards(pagination: { page: 1, itemsPerPage: 10 }) { id name localId } }\"\n}"
						},
						"url": "{{baseUrl}}/v2/graphql"
					}
				},
				{
					"name": "Query - Get card by id",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"query { card(id: \\\"{{cardId}}\\\") { id name rarity category set { id name } } }\"\n}"
						},
						"url": "{{baseUrl}}/v2/graphql"
					}
				},
				{
					"name": "Query - List sets",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"query { sets(pagination: { page: 1, itemsPerPage: 10 }) { id name cardCount { total official } } }\"\n}"
						},
						"url": "{{baseUrl}}/v2/graphql"
					}
				},
				{
					"name": "Query - Get set by id",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"query { set(id: \\\"{{setId}}\\\") { id name releaseDate cards { id localId name } } }\"\n}"
						},
						"url": "{{baseUrl}}/v2/graphql"
					}
				},
				{
					"name": "Query - List series",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"query { series(pagination: { page: 1, itemsPerPage: 10 }) { id name } }\"\n}"
						},
						"url": "{{baseUrl}}/v2/graphql"
					}
				},
				{
					"name": "Query - Get serie by id",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"query { serie(id: \\\"{{serieId}}\\\") { id name sets { id name } } }\"\n}"
						},
						"url": "{{baseUrl}}/v2/graphql"
					}
				},
				{
					"name": "Query - Cards with locale (es)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"query { cards(pagination: { page: 1, itemsPerPage: 5 }) @locale(lang: \\\"es\\\") { id name } }\"\n}"
						},
						"url": "{{baseUrl}}/v2/graphql"
					}
				}
			]
